{
  "name": "dsh-toolbox",
  "version": "0.2.2",
  "description": "DSH 工具箱：把不常改动的插件设置页从设置侧栏收进「工具箱」，需要时在原位展开。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsterionZephyr/dsh-toolbox.git"
  },
  "homepage": "https://github.com/AsterionZephyr/dsh-toolbox",
  "bugs": {
    "url": "https://github.com/AsterionZephyr/dsh-toolbox/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "license": "MIT"
}
